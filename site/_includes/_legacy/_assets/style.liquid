{%- liquid
  if isMentor
    assign stylesheet = 'mentor'
  elsif isSlides
    assign stylesheet = 'slides'
  elsif is360
    assign stylesheet = 'devcards'
  elsif isHexo
    assign stylesheet = 'hexo'
  else
    assign stylesheet = 'style'
  endif
-%}
<link rel="stylesheet" href="{{ '/css/' | append: stylesheet | append: '.css' | assetUrl }}">
{%- if type == 'articles-item' %}
  <link rel="stylesheet" href="{{ '/css/prism-okaidia.css' | assetUrl }}">
{%- endif %}
