<section class="contact margin-top-beta margin-bottom-beta" id="form">
  <div class="wrapper">
    <div class="padding">
      <form action="/contact/thank-you/" method="POST" netlify>
        {% if feedback.title %}
          <h2 class="fz-step-3 ffss">{{ feedback.title }}</h2>
        {% endif %}
        <div class="margin-top margin-bottom">
          <label for="Name">What is your name?</label>
          <input class="input" id="Name" type="text" name="name" autocomplete="name" required>
        </div>
        <div class="margin-top margin-bottom">
          <label for="Email">What is your email address?</label>
          <input class="input" id="Email" type="email" name="email" autocomplete="email" required>
        </div>
        <div class="margin-top margin-bottom">
          <label for="Note">What is your message?</label>
          <textarea class="input" id="Note" name="note" rows="6" required></textarea>
        </div>
        <div class="margin-top margin-bottom">
          <button class="button" type="submit">Submit</button>
        </div>
      </form>
    </div>
  </div>
</section>
