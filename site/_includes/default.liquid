{%- liquid
  assign typeSlug = type | slugify
  assign bodyClass = 'page--' | append: typeSlug
  if subtype
    assign subtypeSlug = subtype | slugify
    assign bodyClass = bodyClass | append: ' page--' | append: subtypeSlug
  endif
  if type == 'articles-item'
    assign bodyClass = bodyClass | append: ' h-entry'
  endif
-%}
<!doctype html>
<html lang="en" dir="ltr">
  {%- include '_components/head' %}
  <body class="{{ bodyClass }}">
    <div class="wrapper">
      {%- include '_components/header' %}
      <main class="main" id="main">
        {%- block content -%}
          {%- for section in sections -%}
            {%- include '_components/sections' -%}
          {%- endfor -%}
          {%- if content != blank and content != '' -%}
            {%- include '_components/content' -%}
          {%- endif -%}
          {%- for section in sections2 -%}
            {%- include '_components/sections' -%}
          {%- endfor -%}
        {%- endblock -%}
      </main>
      {%- include '_components/footer' %}
      {%- include '_components/_assets/analytics' %}
    </div>
  </body>
</html>
