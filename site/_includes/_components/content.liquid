{%- liquid
  assign contentClass = 'content copy'
  if type == 'articles-item'
    assign contentClass = contentClass | append: ' article-content e-content'
  endif
  if tags
    assign firstTag = tags | first
    assign contentClass = contentClass | append: ' ' | append: firstTag
  endif
-%}
{%- if type == 'articles-item' and tags -%}
  {%- include '_components/article-header' -%}
{%- endif %}
<section class="{{ contentClass }}">
  {{ content }}
</section>
{%- if type == 'articles-item' %}
  {%- include '_components/article-footer' -%}
{%- endif %}
