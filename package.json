{
  "name": "silvestar.codes",
  "version": "4.0.16",
  "description": "Home of Silvestar Bistrović—a fearless web engineer, CSS developer, JAMstack enthusiast, WordPress theme specialist, author of the UI Dev Newsletter, and founder of Studio CiTA.",
  "main": "index",
  "repository": {
    "type": "git",
    "url": "https://github.com/maliMirkec/hexo-sb/"
  },
  "keywords": [
    "website",
    "maliMirkec"
  ],
  "author": "maliMirkec <malimirkeccita@gmail.com> (https://www.silvestar.codes)",
  "license": "MIT",
  "homepage": "https://www.silvestar.codes",
  "bugs": {
    "url": "https://github.com/maliMirkec/hexo-sb/issues"
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf public",
    "eleventy-serve": "npx @11ty/eleventy --serve --quiet --watch",
    "eleventy-build": "npx @11ty/eleventy --quiet",
    "dev": "npm run clean && npm run eleventy-serve",
    "prod": "npm run clean && npm run eleventy-serve",
    "build": "npm run clean && npm run eleventy-build",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:format",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:js": "eslint .",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "@anthropic-ai/sdk": "^1.2.0",
    "@netlify/functions": "^6.0.3",
    "autoprefixer": "^10.6.1",
    "cheerio": "^1.2.0",
    "cssnano": "^9.9.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.5.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "netlify-plugin-cache": "^1.0.3",
    "postcss": "^8.5.31",
    "postcss-import": "^17.0.1",
    "postcss-logical": "^9.0.2",
    "postcss-media-minmax": "^5.0.0",
    "sharp": "^0.35.5",
    "staticrafter": "^0.2.0",
    "uslug": "1.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/zip-it-and-ship-it": "^16.5.0",
    "@shopify/prettier-plugin-liquid": "^1.11.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-curly": "^0.4.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.css": "stylelint",
    "*.js": "eslint",
    "*.{js,css,liquid,json,yml}": "prettier --check"
  }
}
